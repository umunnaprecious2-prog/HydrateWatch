NODE_ENV=development
PORT=8000

# CockroachDB connection string (CockroachDB Cloud Serverless free tier
# works fine for local dev too - see README.md "Database: CockroachDB").
# Use sslmode=require (not verify-full - needs a local CA bundle most
# machines don't have set up) and generous timeouts (10s default pool
# timeout is easy to trip over a public-internet connection).
DATABASE_URL=postgresql://user:password@host:26257/hydratewatch?sslmode=require&connect_timeout=30&pool_timeout=30

SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS: the frontend's origin (added to the allowlist alongside localhost).
FRONTEND_URL=http://localhost:3000
