# Used by docker-compose.yml at the repo root to configure the db/backend/frontend
# services together. Copy this to .env (gitignored) and fill in real values before
# running `docker compose up`.

POSTGRES_USER=hydratewatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hydratewatch
POSTGRES_PORT=5432

SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Baked into the frontend's client bundle at build time. Use the URL the
# browser on your host machine will reach the backend at.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
