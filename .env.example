# Used by docker-compose.yml at the repo root to configure the backend and
# frontend services together. Copy this to .env (gitignored) and fill in
# real values before running `docker compose up`.

# CockroachDB connection string (CockroachDB Cloud Serverless free tier
# works fine for local dev too - see README.md "Database: CockroachDB").
# Use sslmode=require (not verify-full - needs a local CA bundle most
# machines don't have set up) and generous timeouts (10s default pool
# timeout is easy to trip over a public-internet connection).
DATABASE_URL=postgresql://user:password@host:26257/hydratewatch?sslmode=require&connect_timeout=30&pool_timeout=30

SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS: the frontend's origin.
FRONTEND_URL=http://localhost:3000

# Baked into the frontend's client bundle at build time. Use the URL the
# browser on your host machine will reach the backend at.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
